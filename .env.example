# Gemini API key for AI-driven interview live conversation and assessment
GEMINI_API_KEY=

# Google Drive Service Account key JSON string for storing interview recordings and CVs
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=

# Google Drive Shared Folder ID for storing interview recordings
DRIVE_RECORDINGS_FOLDER_ID=

# Public URL used in candidate invitation links and the Google OAuth callback
APP_URL=

# One-time app OAuth setup for the Connect Google Drive button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared WorkPodd testing calendar (Cal.com Settings > Security > API keys)
CAL_API_KEY=
CAL_USERNAME=
# Optional: use a particular availability schedule from the shared Cal.com account
CAL_SCHEDULE_ID=

# One InterviewAI sender, configured once with Brevo
BREVO_API_KEY=
EMAIL_FROM=

# Optional private server data directory. Defaults to .local; keep it private.
INTERVIEWAI_DATA_DIR=
